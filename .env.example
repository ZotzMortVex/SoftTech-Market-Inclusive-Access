# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS URL used for app links and password recovery.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL connection used by the Express backend.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="YOUR_MYSQL_PASSWORD"
DB_NAME="softtech_market"

# Express API port.
API_PORT="4000"
SESSION_SECRET="REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET"

# Checkout Pro sandbox only. Copy the Access Token with the Developers dashboard
# set to the Test environment. Depending on the account, it may start with
# APP_USR- or TEST-; the prefix alone does not identify the environment.
# MP_ENVIRONMENT must remain "sandbox"; never use a production credential here.
# MP_RETURN_URL must be public HTTPS and end in /checkout.
MP_ENVIRONMENT="sandbox"
MP_ACCESS_TOKEN="REPLACE_WITH_SELLER_TEST_ACCESS_TOKEN"
MP_RETURN_URL="https://YOUR_PUBLIC_HTTPS_DOMAIN/checkout"

# SMTP settings required for account password recovery.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="SoftTech Market <no-reply@example.com>"
